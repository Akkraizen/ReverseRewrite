TOKEN=replace_with_discord_bot_token
# Local runs only; Docker Compose sets its own DATABASE_URL.
# SQLite: sqlite+aiosqlite:///reverse.db; the Compose database from the host:
DATABASE_URL=postgresql+asyncpg://reverse:replace_with_a_strong_password@localhost:5432/reverse
# Docker Compose only.
POSTGRES_PASSWORD=replace_with_a_strong_password
# Host port of the database; POSTGRES_HOST=0.0.0.0 opens it to other machines (default 127.0.0.1).
POSTGRES_PORT=5432
